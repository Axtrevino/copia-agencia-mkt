      ],
      "parameters": {
        "jsCode": "const T = {\n  'SEO posiciones': ['fecha', 'semana', 'marca', 'keyword', 'origen', 'volumen', 'posicion', 'posicion_anterior', 'cambio', 'url', 'top1', 'top2', 'top3', 'competencia_top10', 'gsc_clics', 'gsc_impresiones', 'gsc_posicion'],\n  'SEO on-page': ['fecha', 'semana', 'marca', 'url', 'status', 'score', 'titulo', 'largo_titulo', 'largo_descripcion', 'h1', 'palabras', 'segundos', 'problemas', 'prioridad', 'impresiones_28d'],\n  'SEO propuestas': ['fecha', 'semana', 'marca', 'url', 'cambio', 'actual', 'propuesta', 'por_que', 'estado', 'decidido'],\n  'SEO reportes': ['fecha', 'semana', 'marca', 'reporte', 'costo_usd'],\n};\nreturn [{ json: {\n  crear: { requests: Object.keys(T).map(title => ({ addSheet: { properties: { title } } })) },\n  encabezados: { valueInputOption: 'RAW', data: Object.entries(T).map(([t, cols]) => ({ range: \"'\" + t + \"'!A1\", values: [cols] })) },\n} }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "b04d3fe2-d7af-5aa0-afcb-bd9a370d7f2f",
      "name": "Crear pestañas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
