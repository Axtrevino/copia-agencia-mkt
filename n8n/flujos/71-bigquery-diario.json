      "parameters": {
        "jsCode": "const b = $('Armar filas').first().json;\nconst res = ['posts', 'cuentas', 'ads'].map(n => { let j = {}, c = {}; try { j = $('Revisar ' + n).first().json || {}; c = $('Cargar ' + n).first().json || {}; } catch (e) {}\n  return { paso: n, estado: (j.status || {}).state || null, error: (c.error && c.error.message) || ((j.status || {}).errorResult || {}).message || (j.error ? String(j.error.message || j.error) : null) }; });\nconst malas = res.filter(r => r.error || r.estado !== 'DONE');\nif (malas.length) throw new Error('Carga a BigQuery no terminó: ' + malas.map(c => `${c.paso}: ${c.error || c.estado}`).join('; ').slice(0, 400));\nreturn [{ json: { hoy: b.hoy, ayer: b.ayer, filas: { post_metrics_daily: b.n_posts, social_account_daily: b.n_social, meta_ads_daily: b.n_ads }, avisos: b.errores } }];\n",
