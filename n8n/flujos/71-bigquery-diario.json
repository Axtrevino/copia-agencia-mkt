      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        100
      ],
      "parameters": {
        "jsCode": "// Posts publicados en los últimos 14 días (la liga trae «facebook  |  instagram»).\nconst hoy = $now.setZone('America/Mexico_City');\nconst ayer = hoy.minus({ days: 1 });\nconst corte = hoy.minus({ days: 14 }).toFormat('yyyy-MM-dd HH:mm');\nconst posts = $input.all().map(i => i.json).filter(r => r && r.post_id && String(r.fecha_hora || '') >= corte).map(r => {\n  const partes = String(r.liga || '').split('  |  ');\n  return { post_id: String(r.post_id), marca: String(r.marca || ''), fecha_hora: String(r.fecha_hora || ''),\n    fb_post_id: (partes[0] || '').trim().replace('https://www.facebook.com/', ''),\n    ig_shortcode: (partes[1] || '').trim().replace(/^https:\\/\\/www\\.instagram\\.com\\/(p|reel)\\//, '').replace(/\\/+$/, '') };\n});\nconst base = { hoy: hoy.toFormat('yyyy-MM-dd'), ayer: ayer.toFormat('yyyy-MM-dd'), since: ayer.startOf('day').toSeconds(), until: hoy.startOf('day').toSeconds() };\nif (!posts.length) return [{ json: { ...base, sin_posts: true, marca: '', fb_post_id: '' } }];\nreturn posts.map(p => ({ json: { ...base, ...p } }));\n",
        "mode": "runOnceForAllItems"
      }
    },
