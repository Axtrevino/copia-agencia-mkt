    {
      "id": "38ce9254-cf20-522c-b4cf-1c706c3a639c",
      "name": "Armar filas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2912,
        100
      ],
      "parameters": {
        "jsCode": "const P = $('Preparar').all().map(i => i.json);\nconst d0 = P[0];\nconst safe = n => { try { return $(n).all().map(i => i.json); } catch (e) { return []; } };\nconst one = n => safe(n)[0] || {};\nconst errMsg = j => j && j.error ? String(j.error.message || j.error.description || JSON.stringify(j.error)) : '';\nconst int = v => (v === undefined || v === null || v === '') ? null : Math.round(Number(v));\nconst valor = (ins, nombre) => { const d = (ins?.data || []).find(x => x.name === nombre); return d?.values?.[0]?.value ?? d?.total_value?.value ?? null; };\nconst errores = [];\nconst MARCAS = { 'marca-a': 'A', 'marca-b': 'B' };\n// Posts\nconst fb = { 'marca-a': safe('FB post A'), 'marca-b': safe('FB post B') };\nconst ig = { 'marca-a': one('IG media A'), 'marca-b': one('IG media B') };\nconst posts = [];\nP.forEach((p, i) => {\n  if (p.sin_posts || !MARCAS[p.marca]) return;\n  const x = fb[p.marca][i] || {}, fe = errMsg(x);\n  const pub = p.fecha_hora ? p.fecha_hora.replace(' ', 'T') + ':00' : null;\n  if (p.fb_post_id) posts.push({ snapshot_date: d0.hoy, post_id: p.post_id, marca: p.marca, canal: 'fb', external_id: p.fb_post_id, published_at: pub,\n    alcance: fe ? null : int(valor(x.insights, 'post_total_media_view_unique')), reacciones: fe ? null : int(x?.reactions?.summary?.total_count ?? 0),\n    comentarios: fe ? null : int(x?.comments?.summary?.total_count ?? 0), compartidos: fe ? null : int(x?.shares?.count ?? 0), guardados: null, error: fe ? fe.slice(0, 500) : null });\n  const media = ((ig[p.marca] || {}).data || []).find(m => m.shortcode === p.ig_shortcode);\n  if (p.ig_shortcode) posts.push({ snapshot_date: d0.hoy, post_id: p.post_id, marca: p.marca, canal: 'ig', external_id: p.ig_shortcode, published_at: pub,\n    alcance: media ? int(valor(media.insights, 'reach')) : null, reacciones: media ? int(media.like_count) : null, comentarios: media ? int(media.comments_count) : null,\n    compartidos: null, guardados: media ? int(valor(media.insights, 'saved')) : null, error: media ? null : (errMsg(ig[p.marca]) || 'post de IG no encontrado en los últimos 100').slice(0, 500) });\n});\nposts.forEach(r => { r.interacciones = r.error ? null : (r.reacciones || 0) + (r.comentarios || 0) + (r.compartidos || 0) + (r.guardados || 0); });\n// Cuentas\nconst dia = (ins, nombre) => { const d = (ins?.data || []).find(x => x.name === nombre); if (!d) return null; if (d.total_value) return int(d.total_value.value); const v = d.values?.[0]; return v ? int(v.value) : null; };\nconst social = [];\nfor (const [m, L] of Object.entries(MARCAS)) {\n  const f = one('FB cuenta ' + L), fe = errMsg(f);\n  social.push({ date: d0.ayer, marca: m, canal: 'fb', account_id: f.id || null, followers: int(f.followers_count ?? f.fan_count), reach: dia(f.insights, 'page_total_media_view_unique'), views: dia(f.insights, 'page_media_view'), profile_views: null, engagements: dia(f.insights, 'page_post_engagements'), error: fe ? fe.slice(0, 500) : null });\n  const g = one('IG cuenta ' + L), ge = errMsg(g);\n  social.push({ date: d0.ayer, marca: m, canal: 'ig', account_id: g.id || null, followers: int(g.followers_count), reach: dia(g.insights, 'reach'), views: dia(g.insights, 'views'), profile_views: dia(g.insights, 'profile_views'), engagements: dia(g.insights, 'total_interactions'), error: ge ? ge.slice(0, 500) : null });\n}\n// Anuncios\nconst leadsDe = a => (a || []).filter(x => /lead/.test(x.action_type)).reduce((s, x) => Math.max(s, Number(x.value) || 0), 0);\nconst ads = [];\nfor (const [m, L] of Object.entries(MARCAS)) {\n  const j = one('Ads ' + L), e = errMsg(j);\n  if (e) errores.push(m + ' anuncios: ' + e);\n  (j.data || []).forEach(r => ads.push({ date: r.date_start || d0.ayer, marca: m, account_id: r.account_id || null, campaign_id: r.campaign_id, campaign_name: r.campaign_name, adset_id: r.adset_id, adset_name: r.adset_name, ad_id: r.ad_id, ad_name: r.ad_name, spend: r.spend ?? null, impressions: int(r.impressions), reach: int(r.reach), clicks: int(r.clicks), leads: int(leadsDe(r.actions)) }));\n}\nposts.filter(r => r.error).forEach(r => errores.push(`post ${r.post_id} ${r.canal}: ${r.error}`));\nsocial.filter(r => r.error).forEach(r => errores.push(`cuenta ${r.marca} ${r.canal}: ${r.error}`));\nconst job = (tabla, fecha, filas, select) => ({ configuration: { query: {\n  query: `SELECT ${select} FROM UNNEST(JSON_QUERY_ARRAY(@filas)) AS j`, useLegacySql: false, parameterMode: 'NAMED',\n  queryParameters: [{ name: 'filas', parameterType: { type: 'STRING' }, parameterValue: { value: JSON.stringify(filas) } }],\n  destinationTable: { projectId: '__BQ_PROYECTO__', datasetId: '__BQ_DATASET__', tableId: `${tabla}$${fecha.replace(/-/g, '')}` },\n  writeDisposition: 'WRITE_TRUNCATE', createDisposition: 'CREATE_NEVER' } }, jobReference: { projectId: '__BQ_PROYECTO__', location: '__BQ_UBICACION__' } });\nconst s = c => `JSON_VALUE(j, '$.${c}') AS ${c}`;\nconst i = c => `SAFE_CAST(JSON_VALUE(j, '$.${c}') AS INT64) AS ${c}`;\nconst L = 'CURRENT_TIMESTAMP() AS loaded_at';\nreturn [{ json: { hoy: d0.hoy, ayer: d0.ayer, n_posts: posts.length, n_social: social.length, n_ads: ads.length, errores,\n  job_posts: job('post_metrics_daily', d0.hoy, posts, [\"CAST(JSON_VALUE(j, '$.snapshot_date') AS DATE) AS snapshot_date\", s('post_id'), s('marca'), s('canal'), s('external_id'), \"SAFE_CAST(JSON_VALUE(j, '$.published_at') AS DATETIME) AS published_at\", i('alcance'), i('interacciones'), i('reacciones'), i('comentarios'), i('compartidos'), i('guardados'), s('error'), L].join(', ')),\n  job_social: job('social_account_daily', d0.ayer, social, [\"CAST(JSON_VALUE(j, '$.date') AS DATE) AS date\", s('marca'), s('canal'), s('account_id'), i('followers'), i('reach'), i('views'), i('profile_views'), i('engagements'), s('error'), L].join(', ')),\n  job_ads: job('meta_ads_daily', d0.ayer, ads, [\"CAST(JSON_VALUE(j, '$.date') AS DATE) AS date\", s('marca'), s('account_id'), s('campaign_id'), s('campaign_name'), s('adset_id'), s('adset_name'), s('ad_id'), s('ad_name'), \"SAFE_CAST(JSON_VALUE(j, '$.spend') AS NUMERIC) AS spend\", i('impressions'), i('reach'), i('clicks'), i('leads'), L].join(', ')),\n} }];\n",
        "mode": "runOnceForAllItems"
      }
    },
