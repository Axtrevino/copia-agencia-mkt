        }
      }
    },
    {
      "id": "9a7cbed8-a4ae-4bb0-9d5d-be320cb00eda",
      "name": "Claude: propuesta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        220,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "__MODAL_URL__/campana",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ marca: $json.body.marca, texto: $json.body.texto, anterior: $json.body.anterior || null }) }}",
        "options": {
          "timeout": 150000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Modal (X-Pieza-Token)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "e0c9a13e-601e-444d-844d-4bc30d0a47ca",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        240
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    },
    {
      "id": "30724c70-90f4-4753-abaa-cd32ab214ea7",
      "name": "Responder error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, mensaje: String($json.error?.message || $json.error?.description || $json.error || 'No se pudo armar la propuesta').slice(0, 400) }) }}",
        "options": {
          "responseCode": 422,
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
