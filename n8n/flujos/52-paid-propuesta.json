      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "agencia-paid-propuesta",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "b8f44707-f4e8-428c-918d-65f67e79b9cf",
