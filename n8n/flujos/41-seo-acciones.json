    {
      "id": "c25d5b51-9805-49ec-adc4-436317bb1582",
      "name": "Leer acción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const u = $input.first().json;\nconst cq = u.callback_query;\nif (cq && String(cq.data || '').startsWith('seo|')) {\n  const d = String(cq.data).split('|');\n  const fotos = cq.message.photo || [];\n  return [{ json: { accion: d[1], row_id: Number(d[2]), version: Number(d[3]), query_id: cq.id,\n    chat_id: cq.message.chat.id, thread_id: cq.message.message_thread_id || null, texto: '',\n    msg_id: cq.message.message_id, foto_id: fotos.length ? fotos[fotos.length - 1].file_id : '',\n    pie: String(cq.message.caption || cq.message.text || '').slice(0, 900) } }];\n}\nconst m = u.message || {};\nconst previo = String(m.reply_to_message?.text || '').split('\\n')[0];\nconst r = previo.match(/#(\\d+) v(\\d+)/);\nif (!r) throw new Error('No entendí a qué artículo responde: ' + previo);\nreturn [{ json: { accion: 'texto', row_id: Number(r[1]), version: Number(r[2]), query_id: null,\n  chat_id: m.chat.id, thread_id: m.message_thread_id || null, texto: String(m.text || '').trim(), msg_id: null, foto_id: '', pie: '' } }];"
      }
    },
