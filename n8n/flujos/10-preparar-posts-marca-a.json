    {
      "id": "687f53a7-d161-46a5-9899-c3ad703cc027",
      "name": "Redactar post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "__MODAL_URL__/redactar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ marca: $(\"Máximo 3\").item.json.marca, post_id: $(\"Máximo 3\").item.json.post_id, fecha: $(\"Máximo 3\").item.json.fecha, version: Number($(\"Máximo 3\").item.json.version) || 0, tipo: $(\"Máximo 3\").item.json.tipo, tema: $(\"Máximo 3\").item.json.tema || \"\", recientes: ((rows, pid, marca) => { const ok = [\"publicado\", \"aprobado\", \"por aprobar\"]; const k = r => String(r.fecha || \"\") + \" \" + String(r.hora || \"\").padStart(5, \"0\"); return rows.filter(r => String(r.marca || '') === String(marca || '') && ok.includes(String(r.estado || \"\").trim().toLowerCase()) && String(r.post_id || \"\") !== String(pid || \"\") && String(r.titular || \"\").trim()).sort((a, b) => k(b).localeCompare(k(a))).slice(0, 8).map(r => ({ fecha: r.fecha, sistema: r.sistema, titular: r.titular, escena: String(r.escena || \"\").slice(0, 200), copy: String(r.copy || \"\").slice(0, 300), kicker: r.kicker, subtitulo: r.subtitulo })); })($(\"Historial\").all().map(i => i.json), $(\"Máximo 3\").item.json.post_id, $(\"Máximo 3\").item.json.marca) }) }}",
        "options": {
          "timeout": 200000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Modal (X-Pieza-Token)"
        }
      },
      "onError": "continueErrorOutput"
    },
