          "fileName": "={{ $json.archivo }}",
          "message_thread_id": "__TEMA_APROBACIONES__",
          "caption": "={{ (() => { const R = $(\"Redactar post\").item.json; const P = $(\"Máximo 3\").item.json; const e = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); return '<b>' + R.post_id + ' · v' + R.version + '</b> · ' + e($('Config').first().json.nombre) + ' · sale ' + e(P.fecha) + ' ' + e(P.hora) + '\\n<i>' + e(R.notas).slice(0, 100) + '</i>\\n\\n' + e(R.copy); })() }}"
        }
      },
