              },
              "outputKey": "aprobar"
            },
            {
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.callback_query?.data ?? \"\" }}",
                    "rightValue": "cambios|",
                    "operator": {
                      "operation": "startsWith",
                      "type": "string"
