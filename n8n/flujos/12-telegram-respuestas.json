    {
      "id": "b9904cb8-dd2e-4aae-9de4-f458e4fede7b",
      "name": "Obtener post_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// post_id desde «✏️ Cambios para ID vN» o desde el pie de la foto («ID · vN · …»).\nreturn $input.all().map(i => {\n  const r = (i.json.message || {}).reply_to_message || {};\n  const t = String(r.text || '');\n  let pid = '';\n  if (t.startsWith('✏️')) pid = t.split('\\n')[0].split(' ')[3] || '';\n  else { const c = String(r.caption || '').match(/^([A-Z]+-[A-Za-z0-9-]+) · v/); if (c) pid = c[1]; }\n  return { json: { ...i.json, post_id: pid } };\n});"
      }
    },
