              },
              "outputKey": "cambios"
            },
            {
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.message?.reply_to_message?.text ?? \"\" }}",
                    "rightValue": "✏️",
                    "operator": {
                      "operation": "startsWith",
                      "type": "string"
                    }
                  }
                ]
              },
              "outputKey": "texto de cambios"
            },
            {
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.message?.text ?? \"\" }}",
                    "rightValue": "/start",
                    "operator": {
                      "operation": "startsWith",
                      "type": "string"
                    }
                  }
                ]
              },
              "outputKey": "start"
            },
            {
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.callback_query?.data ?? \"\" }}",
                    "rightValue": "reintentar|",
                    "operator": {
                      "operation": "startsWith",
                      "type": "string"
                    }
                  }
                ]
              },
              "outputKey": "reintentar"
            },
            {
              "conditions": {
                "combinator": "or",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.callback_query?.data ?? \"\" }}",
                    "rightValue": "seo|",
                    "operator": {
                      "operation": "startsWith",
                      "type": "string"
                    }
                  },
                  {
                    "leftValue": "={{ $json.message?.reply_to_message?.text ?? \"\" }}",
                    "rightValue": "📝",
                    "operator": {
                      "operation": "startsWith",
                      "type": "string"
                    }
                  }
                ]
              },
              "outputKey": "seo"
            },
            {
              "conditions": {
                "combinator": "and",
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.message?.reply_to_message?.caption ?? \"\" }}",
                    "rightValue": "^[A-Z]+-[A-Za-z0-9-]+ · v",
                    "operator": {
                      "operation": "regex",
                      "type": "string"
                    }
                  },
                  {
                    "leftValue": "={{ $json.message?.text ?? \"\" }}",
                    "rightValue": "",
                    "operator": {
                      "operation": "notEmpty",
                      "singleValue": true,
                      "type": "string"
                    }
                  },
                  {
                    "leftValue": "={{ $json.message?.text ?? \"\" }}",
                    "rightValue": "/",
                    "operator": {
                      "operation": "notStartsWith",
                      "type": "string"
                    }
                  }
                ]
              },
              "outputKey": "cambios (respuesta a foto)"
