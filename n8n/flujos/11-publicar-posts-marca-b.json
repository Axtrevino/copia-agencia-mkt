    {
      "id": "c0ff556c-2b5f-402c-b698-e3077bcdfb7c",
      "name": "Ya toca y tiene imagen",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        660,
        360
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ DateTime.fromFormat(String($json.fecha) + ' ' + String($json.hora), 'yyyy-MM-dd HH:mm', { zone: 'America/Mexico_City' }) <= $now }}",
              "rightValue": "",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              }
            },
            {
              "leftValue": "={{ String($json.imagen_url || '') }}",
              "rightValue": "tg:",
              "operator": {
                "operation": "startsWith",
                "type": "string"
              }
            },
            {
              "leftValue": "={{ String($json.copy || '') }}",
              "rightValue": "",
              "operator": {
                "operation": "notEmpty",
                "singleValue": true,
                "type": "string"
              }
            },
            {
              "leftValue": "={{ String($json.fb_url || '') + String($json.ig_url || '') }}",
              "rightValue": "",
              "operator": {
                "operation": "empty",
                "singleValue": true,
                "type": "string"
              }
            }
          ]
        }
      }
    },
