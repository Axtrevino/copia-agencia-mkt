    {
      "id": "576b9e33-e537-489e-a05a-20f1f69bbb22",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pedido del panel: { accion: aprobar | cambios | descartar, post_id, version, texto }.\nconst b = $('Panel acciones').first().json.body || {};\nconst accion = String(b.accion || '');\nif (!['aprobar', 'cambios', 'descartar'].includes(accion)) throw new Error('acción desconocida: ' + accion);\nconst post_id = String(b.post_id || '').trim();\nif (!post_id) throw new Error('falta post_id');\nconst texto = String(b.texto || '').trim().slice(0, 1000);\nif (accion === 'cambios' && !texto) throw new Error('escribe qué cambiar');\nconst r = $input.first().json || {};\nconst estado = String(r.estado || '').trim();\nconst publicado = !!(r.fb_url || r.ig_url) || ['publicado', 'publicando'].includes(estado);\nlet ok = true, motivo = '';\nif (!r.post_id) { ok = false; motivo = 'no existe ' + post_id; }\nelse if (publicado) { ok = false; motivo = 'ya se publicó; nunca se publica dos veces'; }\nelse if (accion === 'aprobar' && estado !== 'por aprobar') { ok = false; motivo = 'está «' + estado + '», no «por aprobar»'; }\nelse if (accion === 'aprobar' && b.version && String(b.version) !== String(r.version)) { ok = false; motivo = 'hay una versión más nueva (v' + r.version + ')'; }\nelse if (accion === 'cambios' && !['por aprobar', 'aprobado', 'cambios pedidos'].includes(estado)) { ok = false; motivo = 'está «' + estado + '»'; }\nreturn [{ json: { accion, post_id, texto, ok, motivo, ruta: !ok ? 3 : accion === 'aprobar' ? 0 : accion === 'cambios' ? 1 : 2 } }];"
      }
    },
