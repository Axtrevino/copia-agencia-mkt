    {
      "id": "2e615242-42db-4ff3-8acc-9f77b836d9c5",
      "name": "Recientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const recientes = ((rows, pid, marca) => { const ok = [\"publicado\", \"aprobado\", \"por aprobar\"]; const k = r => String(r.fecha || \"\") + \" \" + String(r.hora || \"\").padStart(5, \"0\"); return rows.filter(r => String(r.marca || '') === String(marca || '') && ok.includes(String(r.estado || \"\").trim().toLowerCase()) && String(r.post_id || \"\") !== String(pid || \"\") && String(r.titular || \"\").trim()).sort((a, b) => k(b).localeCompare(k(a))).slice(0, 8).map(r => ({ fecha: r.fecha, sistema: r.sistema, titular: r.titular, escena: String(r.escena || \"\").slice(0, 200), copy: String(r.copy || \"\").slice(0, 300), kicker: r.kicker, subtitulo: r.subtitulo })); });\nconst post = $('Leer post').first().json;\nconst rows = $input.all().map(i => i.json);\nreturn [{ json: { ...post, recientes: recientes(rows, post.post_id, post.marca) } }];"
      }
    },
    {
      "id": "ff3eeb43-8845-43d8-bbb0-c452974152ae",
      "name": "Redactar nueva versión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "__MODAL_URL__/redactar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ marca: $json.marca, post_id: $json.post_id, fecha: $json.fecha, version: $json.version, tipo: $json.tipo, tema: $json.tema || '', sistema: $json.sistema, escena: $json.escena, textos: { kicker: $json.kicker, titular: $json.titular, palabra_acento: $json.palabra_acento, subtitulo: $json.subtitulo, cta: $json.cta, url: $json.url, disclaimer: $json.disclaimer }, copy: $json.copy, cambios: $json.cambios_pedidos, recientes: $json.recientes || [] }) }}",
        "options": {
          "timeout": 200000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Modal (X-Pieza-Token)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "41969f51-73ef-46c5-bde7-7655baf275be",
      "name": "Qué rehacer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// copy = misma imagen; textos = se edita la imagen actual; imagen = pieza nueva.\nconst R = $json;\nconst P = $('Recientes').first().json;\nconst img = String(P.imagen_url || '');\nconst tg_file = img.startsWith('tg:') ? img.slice(3) : '';\nlet alcance = ['copy', 'textos', 'imagen'].includes(R.alcance) ? R.alcance : 'imagen';\nif (!tg_file) alcance = 'imagen';\nconst campos = ['kicker', 'titular', 'palabra_acento', 'subtitulo', 'cta', 'url', 'disclaimer'];\nconst textos_antes = {};\nfor (const k of campos) textos_antes[k] = String(P[k] ?? '');\nif (alcance === 'textos' && campos.every(k => String((R.textos || {})[k] ?? '') === textos_antes[k])) alcance = 'copy';\nreturn [{ json: Object.assign({}, R, { alcance, tg_file, textos_antes, costo_anterior: P.costo_usd ?? '', ruta: alcance === 'copy' ? 0 : alcance === 'textos' ? 1 : 2 }) }];"
      }
    },
    {
      "id": "293d1cfe-6ee9-4754-999d-7bdd9b68c62d",
