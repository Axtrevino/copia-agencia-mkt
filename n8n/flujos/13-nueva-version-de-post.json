          "caption": "={{ (() => { const R = $('Redactar nueva versión').first().json; const Q = $('Qué rehacer').first().json; const e = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const nota = Q.alcance === 'copy' ? 'Misma imagen: solo cambió el texto del post.' : Q.alcance === 'textos' ? 'Imagen editada: solo cambiaron sus textos.' : ''; return '<b>' + R.post_id + ' · v' + R.version + '</b> · ' + e(R.marca) + '\\n<i>' + (nota ? nota + ' ' : '') + e(R.notas).slice(0, nota ? 70 : 120) + '</i>\\n\\n' + e(R.copy); })() }}"
        }
