    {
      "id": "fa210042-26b3-5dec-a4d9-fa8a6eba655c",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2912,
        304
      ],
      "parameters": {
        "jsCode": "// Arma el estado final de la fila y el texto para Telegram.\nconst V = $('Validar').first().json;\nlet P = V; try { if ($('Preparar cambio').isExecuted) P = $('Preparar cambio').first().json; } catch (e) {}\nlet escrito = null;\nfor (const n of ['Meta A (escribir)', 'Meta B (escribir)']) { try { if ($(n).isExecuted) escrito = $(n).first().json; } catch (e) {} }\nconst ahora = $now.setZone('America/Mexico_City').toFormat('yyyy-MM-dd HH:mm');\nconst e = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nlet estado = '', texto = '', cambiar = false;\nif (P.tipo === 'rechazar') { estado = 'rechazada'; cambiar = true; texto = '❌ No aprobada. No cambié nada.'; }\nelse if (P.tipo === 'invalido') texto = 'ℹ️ No lo apliqué: ' + P.razon + '.';\nelse if (P.tipo === 'error') texto = '⚠️ ' + P.razon;\nelse if (P.ok && V.simular) texto = '🧪 Simulación: se habría escrito «' + P.cuerpo + '» en ' + P.objeto + '.';\nelse if (P.ok) {\n  const b = escrito || {};\n  if (escrito && !b.error) {\n    estado = 'aprobada'; cambiar = true;\n    texto = P.tipo === 'pausar' ? '⏸️ Listo: pausé el conjunto.' : '✅ Listo: presupuesto de MXN ' + P.actual + ' a ' + P.monto + ' al día' + (P.en_campana ? ' (en la campaña)' : '') + '.';\n  } else { estado = 'error'; cambiar = true; texto = '⚠️ Meta no aceptó el cambio: ' + String((b.error && (b.error.error_user_msg || b.error.message)) || 'sin respuesta').slice(0, 200); }\n}\nconst f = P.fila || {};\nreturn [{ json: { simular: V.simular, q: V.q, row_id: f.id || 0, cambiar: cambiar && !!f.id, estado,\n  detalle: (String(f.detalle || '') + ' · ' + ahora + ' ' + (V.decision === 'ok' ? '✅' : '❌') + ': ' + texto).slice(0, 500), texto,\n  html: e(String((V.q.message || {}).text || '').slice(0, 3500)) + '\\n\\n<b>' + e(texto) + '</b>' } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
