    {
      "id": "81505428-1d49-50b9-949e-8c8742224bce",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        416
      ],
      "parameters": {
        "jsCode": "// Revisa la propuesta antes de tocar Meta: tope diario por campaña, +20 % máximo,\n// una subida cada 3 días por conjunto y la propuesta debe ser de hace 2 días o menos.\nconst TOPE = 300; // MXN al día por campaña; el mismo del optimizador y de «Paid campañas»\nconst B = $('Leer botón').first().json;\nlet f = $('Leer propuesta').first().json || {};\nconst num = v => Number(v) || 0;\nconst ahora = $now.setZone('America/Mexico_City');\nif (B.simular && f.id) f = Object.assign({}, f, { estado: 'propuesta', accion: f.accion === 'pausar' ? 'pausar' : 'subir presupuesto', propuesta_presupuesto: f.propuesta_presupuesto || TOPE, fecha: ahora.toFormat('yyyy-MM-dd HH:mm') });\nconst out = (tipo, razon, extra) => [{ json: Object.assign({ simular: B.simular, q: B.q, decision: B.decision, tipo, razon: razon || '', fila: f, marca: f.marca || '' }, extra || {}) }];\nif (!B.decision || !B.row_id) return out('invalido', 'el botón no trae datos válidos');\nif (!f.id) return out('invalido', 'no encontré la propuesta en la bitácora');\nif (String(f.estado) !== 'propuesta') return out('invalido', 'ya estaba «' + f.estado + '»');\nif (B.decision === 'no') return out('rechazar');\nconst fecha = String(f.fecha || '').slice(0, 10);\nif (!fecha || fecha < ahora.minus({ days: 2 }).toFormat('yyyy-MM-dd')) return out('invalido', 'la propuesta es del ' + fecha + ' y los datos ya cambiaron; espera la de la siguiente corrida');\nif (f.accion === 'pausar') return out('pausar');\nif (f.accion !== 'subir presupuesto') return out('invalido', 'esta propuesta no se aplica con botón (' + f.accion + ')');\nconst monto = num(f.propuesta_presupuesto);\nif (!(monto > 0 && monto <= TOPE)) return out('invalido', 'el monto propuesto (MXN ' + monto + ') está fuera del tope de MXN ' + TOPE + ' al día');\nconst hace3 = $now.toUTC().minus({ days: 3 }).toMillis();\nconst reciente = $('Subidas aplicadas').all().map(i => i.json).some(r => r && r.adset_id === f.adset_id && new Date(r.updatedAt || 0).getTime() >= hace3);\nif (reciente) return out('invalido', 'a este conjunto ya le subí el presupuesto en los últimos 3 días');\nreturn out('subir', '', { monto });\n",
        "mode": "runOnceForAllItems"
      }
    },
