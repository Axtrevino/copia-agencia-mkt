    {
      "id": "0972af38-d4a2-50de-bedf-9c7c8fca1e2d",
      "name": "Ejemplo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        288
      ],
      "parameters": {
        "jsCode": "// Simula que tocaste ✅ en la fila más reciente. No cambia nada en Meta, ni en la tabla, ni en Telegram.\nconst f = $input.first().json || {};\nreturn [{ json: { simular: true, callback_query: { id: '', data: 'meta|ok|' + (f.id || 0), message: { chat: { id: 0 }, message_id: 0, text: 'prueba' } } } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "4cbdcd9a-3a67-5d95-9c90-0ca89f45bc5b",
      "name": "Leer botón",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        416
      ],
      "parameters": {
        "jsCode": "// Botón: meta|ok|<id fila> o meta|no|<id fila> (id de meta_ads_decisiones).\nconst x = $input.first().json || {};\nconst q = x.callback_query || {};\nconst p = String(q.data || '').split('|');\nreturn [{ json: { simular: !!x.simular, q, decision: p[1] === 'ok' ? 'ok' : (p[1] === 'no' ? 'no' : ''), row_id: Number(p[2]) || 0 } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
