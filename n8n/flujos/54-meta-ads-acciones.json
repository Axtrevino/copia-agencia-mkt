    {
      "id": "c8a4db3b-f9f2-5008-b92f-32866335e2fc",
      "name": "Preparar cambio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        320
      ],
      "parameters": {
        "jsCode": "// Con el estado actual en Meta decide qué se escribe. El presupuesto puede estar en el conjunto o en la campaña.\nconst V = $('Validar').first().json;\nconst r = $input.first().json || {};\nconst b = r.error ? { error: r.error } : r;\nconst num = v => Number(v) || 0;\nconst out = (ok, extra) => [{ json: Object.assign({}, V, { ok }, extra) }];\nif (b.error || !b.id) return out(false, { tipo: 'error', razon: 'no pude leer el conjunto en Meta: ' + String((b.error && b.error.message) || 'sin respuesta').slice(0, 200) });\nif (V.tipo === 'pausar') {\n  if (b.effective_status === 'PAUSED' || b.effective_status === 'CAMPAIGN_PAUSED') return out(false, { tipo: 'invalido', razon: 'ya estaba en pausa' });\n  return out(true, { objeto: V.fila.adset_id, cuerpo: 'status=PAUSED' });\n}\nconst enCampana = !num(b.daily_budget) && b.campaign && num(b.campaign.daily_budget);\nconst objeto = enCampana ? b.campaign.id : V.fila.adset_id;\nconst actual = (enCampana ? num(b.campaign.daily_budget) : num(b.daily_budget)) / 100;\nif (!actual) return out(false, { tipo: 'invalido', razon: 'el conjunto no tiene presupuesto diario (¿es de por vida?); no lo cambio' });\nif (V.monto <= actual) return out(false, { tipo: 'invalido', razon: 'ya tiene MXN ' + actual + ' al día' });\nif (V.monto > Math.round(actual * 1.2) + 1) return out(false, { tipo: 'invalido', razon: 'el presupuesto cambió (hoy MXN ' + actual + '); subir a ' + V.monto + ' sería más de 20 %' });\nreturn out(true, { objeto, actual, en_campana: !!enCampana, cuerpo: 'daily_budget=' + Math.round(V.monto * 100) });\n",
        "mode": "runOnceForAllItems"
      }
    },
