    {
      "id": "1a749126-5d66-5cb5-89e1-2e2c028f4d35",
      "name": "Resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "const err = j => (j && j.error) ? String(j.error.message || j.error) : '';\nconst flujos = $('Flujos').all().map(i => i.json || {});\nconst corridas = $('Corridas').all().map(i => i.json || {});\nconst gh = $('Encargos').all().map(i => i.json || {});\nconst hace24 = $now.toUTC().minus({ hours: 24 }).toISO();\nconst issues = gh.length === 1 && Array.isArray(gh[0]) ? gh[0] : gh;\nreturn [{ json: {\n  generado: $now.setZone('America/Mexico_City').toFormat('yyyy-MM-dd HH:mm'),\n  error_n8n: err(flujos[0]) || (flujos.length && !flujos[0].id ? 'sin flujos' : ''),\n  flujos: flujos.filter(w => w.id).map(w => ({ id: w.id, nombre: w.name, activo: !!w.active, actualizado: w.updatedAt })),\n  corridas: corridas.filter(x => x.id && String(x.startedAt || '') >= hace24).map(x => ({ flujo: x.workflowId, estado: x.status || (x.finished ? 'success' : 'error'), modo: x.mode, inicio: x.startedAt, fin: x.stoppedAt })),\n  error_github: err(issues[0]) || (issues[0] && issues[0].message ? issues[0].message : ''),\n  encargos: issues.filter(x => x && x.number && !x.pull_request).map(x => ({ numero: x.number, titulo: x.title, estado: x.state, etiquetas: (x.labels || []).map(l => l.name), url: x.html_url, actualizado: x.updated_at })),\n} }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "d42f5f1c-a89d-50a6-8770-c920a89d8a55",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
