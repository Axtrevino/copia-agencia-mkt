      "typeVersion": 2,
      "position": [
        672,
        300
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nreturn [{ json: r.number ? { ok: true, mensaje: 'Encargo #' + r.number + ' creado.', url: r.html_url } : { ok: false, mensaje: 'GitHub no aceptó el encargo: ' + (r.message || 'sin respuesta') } }];",
        "mode": "runOnceForAllItems"
      }
    },
