    {
      "id": "3ff08c09-4cd6-5835-ae70-9a62b586dd76",
      "name": "Validar encargo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        300
      ],
      "parameters": {
        "jsCode": "const b = ($json.body || {});\nconst titulo = String(b.titulo || '').trim().slice(0, 140), detalle = String(b.detalle || '').trim().slice(0, 4000);\nif (titulo.length < 5) throw new Error('Escribe un título de al menos 5 letras.');\nreturn [{ json: { titulo, cuerpo: { title: titulo, body: (detalle || 'Sin detalle.') + '\\n\\n_Encargo creado desde el panel._', labels: ['encargo'] } } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "ccd22e66-a258-560b-9a44-04289085629b",
      "name": "Crear issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        300
      ],
