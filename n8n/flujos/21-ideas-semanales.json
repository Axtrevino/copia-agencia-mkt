    {
      "id": "e60d3fd3-13fa-44d4-854a-6aea610c1f36",
      "name": "Pedido con voz",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Voz del público: comentarios en los posts de la competencia; sus posts orgánicos entran como hallazgos.\nconst m = $('Ideas de una marca').first().json;\nconst corto = (s, n) => String(s || '').replace(/\\s+/g, ' ').trim().slice(0, n);\nconst nombre = u => { const x = String(u || '').match(/facebook\\.com\\/([^/?]+)/); return x ? x[1] : ''; };\nconst posts = $('Apify: posts competencia').all().map(i => i.json).filter(p => p && p.url && p.text);\nconst organicos = posts.map(p => ({ tipo: 'competencia', hallazgo: 'Post orgánico de ' + (p.pageName || nombre(p.facebookUrl || p.url)) + ' (' + String(p.time || '').slice(0, 10) + '): ' + corto(p.text, 300), fuente: p.url, accion: 'contenido' }));\nconst basura = /^(informaci[oó]n|info|me interesa|amen|amén|gracias|muchas gracias|felicidades|excelente|jaja.*|\\W*)$/i;\nconst voz = $('Apify: comentarios').all().map(i => i.json)\n  .filter(c => c && c.text && !c.error && corto(c.text, 400).length >= 15 && !basura.test(corto(c.text, 400)))\n  .slice(0, 80)\n  .map(c => ({ comentario: corto(c.text, 300), sobre: corto(c.postTitle, 120), pagina: nombre(c.facebookUrl || c.inputUrl), url: c.commentUrl || c.facebookUrl }));\nreturn [{ json: { ...m, hallazgos: [...m.hallazgos, ...organicos].slice(0, 60), voz } }];"
      }
    },
