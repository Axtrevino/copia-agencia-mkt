    {
      "id": "57a18d81-8419-41ac-92c7-43b31cb0bd50",
      "name": "Posts con comentarios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const posts = $input.all().map(i => i.json).filter(p => p && p.url && !p.error);\nconst con = posts.filter(p => Number(p.comments) > 0).sort((a, b) => Number(b.comments) - Number(a.comments)).slice(0, 15).map(p => p.url);\nreturn [{ json: { con } }];"
      }
    },
    {
      "id": "da0b8c71-69a6-41b3-82b7-468ee3b20008",
      "name": "Apify: comentarios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        600
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://api.apify.com/v2/acts/apify~facebook-comments-scraper/run-sync-get-dataset-items?timeout=280",
        "jsonBody": "={{ JSON.stringify({ startUrls: $json.con.map(u => ({ url: u })), resultsLimit: 20, includeNestedComments: false }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 300000
        }
