      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const salida = [];\nfor (const it of $input.all()) {\n  for (const i of (it.json.ideas || [])) {\n    const fuente = i.fuente ? ' | Fuente: ' + i.fuente : '';\n    salida.push({ json: { post_id: i.post_id, tema: i.tema + fuente } });\n  }\n}\nreturn salida;"
      }
