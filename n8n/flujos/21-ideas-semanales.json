    {
      "id": "f2f882f2-536c-4f4c-b31d-cd281043fa16",
      "name": "Armar pedidos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Por marca: posts por afilar (planeado, de hoy a 8 días, cuyo tema aún no es un brief «Insight: ...»),\n// hallazgos de 3 semanas y lo ya escrito. Un tema que empieza con «Insight:» no se toca.\nconst hoy = $now.setZone('America/Mexico_City');\nconst desde = hoy.toFormat('yyyy-MM-dd');\nconst hasta = hoy.plus({ days: 8 }).toFormat('yyyy-MM-dd');\nconst corte = hoy.minus({ days: 21 }).toFormat('yyyy-MM-dd');\nconst esBrief = t => /^\\s*Insight:/i.test(String(t || ''));\nconst filas = $('Calendario').all().map(i => i.json).filter(r => r && r.post_id);\nconst hallazgos = $('Hallazgos').all().map(i => i.json).filter(h => h && h.hallazgo);\nconst salida = [];\nfor (const m of $('Marcas').first().json.marcas) {\n  const todas = filas.filter(r => r.marca === m.marca);\n  const posts = todas\n    .filter(r => String(r.estado).trim() === 'planeado' && !esBrief(r.tema))\n    .filter(r => String(r.fecha) >= desde && String(r.fecha) <= hasta)\n    .sort((a, b) => String(a.fecha).localeCompare(String(b.fecha)))\n    .map(r => ({ post_id: r.post_id, fecha: String(r.fecha), tipo: r.tipo || '', tema_previo: String(r.tema || '').trim() }));\n  if (!posts.length) continue;\n  const ids = new Set(posts.map(p => p.post_id));\n  const publicados = todas\n    .filter(r => !ids.has(r.post_id) && (r.titular || String(r.tema || '').trim()))\n    .sort((a, b) => String(b.fecha).localeCompare(String(a.fecha)))\n    .slice(0, 15)\n    .map(r => ({ fecha: String(r.fecha), tipo: r.tipo || '', tema: String(r.tema || '').slice(0, 200), titular: r.titular || '' }));\n  const hs = hallazgos\n    .filter(h => h.marca === m.marca && String(h.fecha) >= corte && h.tipo !== 'keywords')\n    .slice(-25)\n    .map(h => ({ tipo: h.tipo, hallazgo: h.hallazgo, fuente: h.fuente || '', accion: h.accion || '' }));\n  salida.push({ json: { ...m, posts, publicados, hallazgos: hs } });\n}\nreturn salida;"
      }
    },
