      "name": "Telegram: ideas de la semana",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1540,
        400
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "__TELEGRAM_CHAT_ID__",
        "text": "={{ (() => { const e = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const P = $('Pedido con voz').first().json; const fechas = {}; P.posts.forEach(x => { fechas[x.post_id] = x.fecha + ' · ' + x.tipo; }); const r = $('Modal: ideas').first().json; let t = '💡 <b>Ideas de la semana · ' + e(P.nombre) + '</b>\\nYa están en la columna «tema» del Sheet; cámbialas ahí si quieres antes de que se preparen.\\n\\n' + e(r.resumen) + '\\n'; for (const i of (r.ideas || [])) { const g = (String(i.tema).split('Gancho:')[1] || '').split('|')[0].trim(); t += '• ' + e(fechas[i.post_id] || i.post_id) + ' [' + e(i.fuente_tipo) + ']: ' + e(g) + '\\n'; } return t.slice(0, 4000); })() }}",
        "additionalFields": {
          "appendAttribution": false,
          "message_thread_id": "__TEMA_REPORTES__",
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "credentials": {
