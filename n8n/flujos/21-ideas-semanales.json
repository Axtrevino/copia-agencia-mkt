        "jsCode": "// Por marca: búsqueda de la voz del público y páginas de Facebook de la competencia (posts y\n// comentarios recientes con Apify). Agrega o quita marcas aquí.\nreturn [{ json: { marcas: [\n  { marca: 'marca-a', nombre: 'Marca A', paginas: ['https://www.facebook.com/competidor1', 'https://www.facebook.com/competidor2'] },\n  { marca: 'marca-b', nombre: 'Marca B', paginas: ['https://www.facebook.com/competidor3'] },\n] } }];"
      }
