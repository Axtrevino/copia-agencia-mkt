    },
    {
      "id": "2a03fba6-d75d-5ab4-973a-5884d50ed348",
      "name": "Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "const V = $('Validar').first().json;\nconst r = $input.first().json || {};\nif (!V.ok) return [{ json: V }];\nif (r.error) return [{ json: { ok: false, mensaje: 'El Sheet no aceptó el cambio: ' + (r.error.message || '') } }];\nreturn [{ json: { ok: true, mensaje: V.n + (V.n === 1 ? ' propuesta ' : ' propuestas ') + (V.estado === 'aprobado' ? 'aprobada' : 'descartada') + (V.n === 1 ? '' : 's') + (V.estado === 'aprobado' ? '. Quedan en el Sheet para aplicarlas en el sitio.' : '.') } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "49d9302a-5ec4-5e15-b874-1fa5f83e8d7a",
      "name": "Responder",
