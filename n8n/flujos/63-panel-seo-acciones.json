    {
      "id": "a9819312-5a3b-5c4b-a90f-6ebec4b92f76",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "// Solo cambia filas que siguen «propuesto». aprobar → «aprobado» (se aplica a mano en el sitio); descartar → «descartado».\nconst b = ($('Panel SEO').first().json.body || {});\nconst accion = String(b.accion || '');\nif (!['aprobar', 'descartar'].includes(accion)) return [{ json: { ok: false, mensaje: 'Acción no válida.' } }];\nconst filas = [...new Set((Array.isArray(b.filas) ? b.filas : [b.fila]).map(Number).filter(n => Number.isInteger(n) && n >= 2))];\nconst v = ($input.first().json.values || []);\nconst vigentes = filas.filter(n => (v[n - 1] || [])[8] === 'propuesto');\nif (!vigentes.length) return [{ json: { ok: false, mensaje: 'Esas propuestas ya no están por aprobar.' } }];\nconst estado = accion === 'aprobar' ? 'aprobado' : 'descartado';\nconst cuando = $now.setZone('America/Mexico_City').toFormat('yyyy-MM-dd HH:mm');\nreturn [{ json: { ok: true, estado, n: vigentes.length, cuerpo: { valueInputOption: 'RAW', data: vigentes.map(n => ({ range: \"'SEO propuestas'!I\" + n + ':J' + n, values: [[estado, cuando]] })) } } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "77bf2a1e-5209-54a0-bee2-1cda59f072e9",
      "name": "Escribir",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        0
      ],
      "parameters": {
