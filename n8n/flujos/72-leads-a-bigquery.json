        "url": "={{ 'https://bigquery.googleapis.com/bigquery/v2/projects/__BQ_PROYECTO__/jobs/' + (($('BigQuery: cargar').first().json.jobReference || {}).jobId || 'sin-job') + '?location=__BQ_UBICACION__' }}",
        "authentication": "predefinedCredentialType",
