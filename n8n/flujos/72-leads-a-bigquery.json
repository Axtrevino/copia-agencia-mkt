    {
      "id": "6c443b61-9551-5f43-8fd4-d6eadb7a12b6",
      "name": "Fallar si no cargó",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        100
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json || {};\nconst c = $('BigQuery: cargar').first().json || {};\nconst err = (c.error && c.error.message) || (j.status && j.status.errorResult && j.status.errorResult.message) || (j.error && j.error.message);\nif (err || (j.status && j.status.state) !== 'DONE') throw new Error('Carga de leads a BigQuery: ' + (err || (j.status && j.status.state) || 'sin estado'));\nreturn [{ json: { ok: true, filas: $('Armar carga').first().json.n } }];\n",
        "mode": "runOnceForAllItems"
      }
    }
