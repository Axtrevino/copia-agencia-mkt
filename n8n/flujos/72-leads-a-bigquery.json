    {
      "id": "d11a493a-9109-588c-94f9-4d8833306127",
      "name": "Armar carga",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        100
      ],
      "parameters": {
        "jsCode": "// Sin datos de contacto (nombre, correo, teléfono, mensaje): BigQuery es para el embudo; el Sheet, para dar seguimiento.\nconst C = ['lead_id','fecha','marca','origen','estado','empresa','tipo','pagina','landing','referrer','utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','fbclid','fbp','fbc','event_id','notas','actualizado'];\nconst filas = $input.all().map(i => i.json).filter(r => r && r.lead_id).map(r => Object.fromEntries(C.map(c => [c, String(r[c] ?? '')])));\nconst s = c => `NULLIF(JSON_VALUE(j, '$.${c}'), '') AS ${c}`;\nconst ts = c => `TIMESTAMP(COALESCE(SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M:%S', JSON_VALUE(j, '$.${c}')), SAFE.PARSE_DATETIME('%Y-%m-%d %H:%M', JSON_VALUE(j, '$.${c}'))), 'America/Mexico_City') AS ${c}`;\nconst cols = C.map(c => (c === 'fecha' || c === 'actualizado') ? ts(c) : s(c));\nconst job = { configuration: { query: {\n  query: `SELECT ${cols.join(', ')}, CURRENT_TIMESTAMP() AS loaded_at FROM UNNEST(JSON_QUERY_ARRAY(@filas)) AS j`,\n  useLegacySql: false, parameterMode: 'NAMED',\n  queryParameters: [{ name: 'filas', parameterType: { type: 'STRING' }, parameterValue: { value: JSON.stringify(filas) } }],\n  destinationTable: { projectId: '__BQ_PROYECTO__', datasetId: '__BQ_DATASET__', tableId: 'leads' },\n  writeDisposition: 'WRITE_TRUNCATE', createDisposition: 'CREATE_IF_NEEDED' } }, jobReference: { projectId: '__BQ_PROYECTO__', location: '__BQ_UBICACION__' } };\nreturn [{ json: { n: filas.length, job } }];\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "8eccbca3-3f94-5b03-a710-f547f8641653",
      "name": "BigQuery: cargar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
