    {
      "id": "a97ee173-7092-487b-ab87-de0c98d0d1db",
      "name": "Armar pedido a GPT",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Preparar pedido').first().json;\nfunction buscar(valor, llave) {\n  if (valor === null || valor === undefined) return null;\n  if (Array.isArray(valor)) { for (const v of valor) { const r = buscar(v, llave); if (r !== null) return r; } return null; }\n  if (typeof valor === 'object') {\n    if (valor[llave] !== undefined && valor[llave] !== null && typeof valor[llave] !== 'object') return valor[llave];\n    for (const v of Object.values(valor)) { const r = buscar(v, llave); if (r !== null) return r; }\n  }\n  return null;\n}\nlet vol = null, cpc = null, kd = null;\ntry { const d = $('Volumen (DataForSEO)').all().map(i => i.json); vol = buscar(d, 'search_volume'); cpc = buscar(d, 'cpc'); } catch (e) {}\ntry { kd = buscar($('Dificultad (DataForSEO)').all().map(i => i.json), 'keyword_difficulty'); } catch (e) {}\nlet titulos = [];\ntry { titulos = $('Ya publicados').all().map(i => i.json.titulo).filter(Boolean); } catch (e) {}\nlet tema = p.tema;\nif (p.cambios) tema += '\\n\\nEsta es una versión corregida. Título de la versión anterior: «' + (p.titulo || '') + '». Cambios que pidió el aprobador y que debes aplicar al pie de la letra: ' + p.cambios;\nconst cuerpo = { marca: p.marca, tema, keyword: p.keyword, enlaces_internos: p.cfg.enlaces_internos, publicados: titulos };\nif (p.intencion) cuerpo.intencion = p.intencion;\nreturn [{ json: { cuerpo, volumen: vol === null ? null : Number(vol), cpc: cpc === null ? null : Number(cpc), dificultad: kd === null ? null : Number(kd) } }];"
      }
    },
