    {
      "id": "feac09ec-569b-4ee3-a935-32c30cccb34d",
      "name": "Armar borrador",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        60
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Preparar pedido').first().json;\nconst a = $('Redactar artículo').first().json;\nconst datos = $('Armar pedido a GPT').first().json;\nconst img = $('Registrar imagen en Webflow').first().json.hostedUrl;\nconst v = p.version_nueva;\nconst c = p.cfg.campos;\nconst e = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst faq = Array.isArray(a.faq) ? a.faq : [];\nconst faqHtml = faq.length ? '<h2>Preguntas frecuentes</h2>' + faq.map(f => '<h3>' + e(f.pregunta) + '</h3><p>' + e(f.respuesta) + '</p>').join('') : '';\nconst cuerpo = a.cuerpo_html + faqHtml;\nconst fieldData = { name: a.titulo, slug: a.slug };\nfieldData[c.resumen] = a.meta_descripcion;\nfieldData[c.cuerpo] = cuerpo;\nfieldData[c.imagen] = { url: img, alt: a.titulo };\nfieldData[c.miniatura] = { url: img, alt: a.titulo };\nfieldData[c.fecha] = new Date().toISOString();\nfieldData[c.destacado] = false;\nconst base = 'https://api.webflow.com/v2/collections/' + p.cfg.collectionId + '/items';\nconst existe = String(p.webflow_item_id || '').trim();\nconst url = p.cfg.dominio + p.cfg.rutaPost + a.slug;\nconst n = x => (x === null || x === undefined || Number.isNaN(x)) ? '—' : String(x);\nconst html = '<!doctype html><html lang=\"es\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>' + e(a.titulo) + '</title>'\n  + '<style>body{font-family:-apple-system,Segoe UI,Roboto,sans-serif;max-width:720px;margin:0 auto;padding:16px;line-height:1.6;color:#1a1a1a}'\n  + '.aviso{background:#fff4d6;border:1px solid #f0c36d;padding:10px 12px;border-radius:8px;font-size:14px}'\n  + '.meta{color:#555;font-size:14px}img{width:100%;border-radius:10px;margin:12px 0}h1{line-height:1.25}'\n  + 'table{border-collapse:collapse;width:100%}td,th{border:1px solid #ddd;padding:6px}</style></head><body>'\n  + '<div class=\"aviso\">BORRADOR v' + v + ' · ' + e(p.cfg.nombre) + ' · no publicado. Se publicará en ' + e(url) + '</div>'\n  + '<h1>' + e(a.titulo) + '</h1>'\n  + '<p class=\"meta\"><b>Meta descripción:</b> ' + e(a.meta_descripcion) + '<br><b>Keyword:</b> ' + e(p.keyword) + ' · ' + n(datos.volumen) + ' búsquedas/mes · dificultad ' + n(datos.dificultad) + '<br><b>Palabras:</b> ' + n(a.palabras) + '</p>'\n  + '<img src=\"' + e(img) + '\" alt=\"\">' + cuerpo + '</body></html>';\nconst caption = '<b>📰 SEO ' + e(p.cfg.nombre) + ' · #' + p.row_id + ' v' + v + '</b>\\n<b>' + e(a.titulo) + '</b>\\n\\n'\n  + 'Keyword: ' + e(p.keyword) + ' · ' + n(datos.volumen) + '/mes · dificultad ' + n(datos.dificultad) + '\\n'\n  + n(a.palabras) + ' palabras · ' + e(p.cfg.rutaPost + a.slug) + '\\n\\n<i>' + e(a.meta_descripcion) + '</i>\\n\\n'\n  + '📝 ' + e(String(a.notas || '').slice(0, 200)) + '\\n\\nArriba va el archivo con el artículo completo para leerlo.';\nreturn [{ json: { metodo: existe ? 'PATCH' : 'POST', endpoint: existe ? base + '/' + existe : base, item: { isDraft: true, isArchived: false, fieldData },\n  html_b64: Buffer.from(html, 'utf8').toString('base64'), archivo_html: a.slug + '-v' + v + '.html', caption: caption.slice(0, 1020), img, url, version: v } }];"
      }
    },
