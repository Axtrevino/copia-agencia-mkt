    {
      "id": "3e97780c-dfc3-48bf-97c1-680ae91609d6",
      "name": "Preparar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const fila = $input.first().json;\nlet cambios = '';\ntry { cambios = String($('Pedido de cambios').first().json.cambios || '').trim(); } catch (e) { cambios = ''; }\n// CONFIGURA cada marca con blog en Webflow (Site ID y Collection ID del blog en Webflow → Settings).\n// Los nombres de campo (fieldData) son los de la plantilla de blog de Webflow; cámbialos si tu\n// colección usa otros.\nconst MARCAS = {\n  'marca-a': {\n    nombre: 'Marca A',\n    siteId: '__WEBFLOW_SITE_ID_A__',\n    collectionId: '__WEBFLOW_COLLECTION_ID_A__',\n    dominio: 'https://www.__DOMINIO_A__',\n    rutaPost: '/post/',\n    enlaces_internos: ['https://www.__DOMINIO_A__/', 'https://www.__DOMINIO_A__/contacto', 'https://www.__DOMINIO_A__/blog'],\n    campos: { resumen: 'post-summary', cuerpo: 'post-body', imagen: 'main-image', miniatura: 'thumbnail-image', fecha: 'date-published', destacado: 'featured' },\n  },\n};\nconst cfg = MARCAS[fila.marca];\nif (!cfg) throw new Error('La marca ' + fila.marca + ' no tiene configuración de SEO en «Preparar pedido»');\nreturn [{ json: { ...fila, row_id: fila.id, cambios, cfg, version_nueva: (Number(fila.version) || 0) + 1 } }];"
      }
    },
